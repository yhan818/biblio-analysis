cat("1. UNIQUE ID METRICS:\n")
cat("   - Stable Core IDs (No Change):       ", nrow(stable_core), "\n")
cat("   - Growth IDs (Gained Citations):     ", nrow(growth_pool), "\n")
cat("   - Leaked IDs (Lost Citations):       ", nrow(leakage_pool), "\n")
cat("   - Brand New IDs (Added in 2026):     ", nrow(new_listings), "\n")
cat("   -----------------------------------------------\n")
cat("   Total Unique IDs Encountered:        ", nrow(change_ledger), "\n\n")
cat("2. CITATION ROW-LEVEL ANALYSIS:\n")
cat("   - Citations Retained (Baseline):     ", sum(change_ledger[, pmin(Count_2025, Count_2026)]), "\n")
cat("   - New Citations (Pure Growth):       ", sum(growth_pool$Net_Variance) + sum(new_listings$Count_2026), "\n")
cat("   - Erased Citations (Pure Leakage):   ", sum(abs(leakage_pool$Net_Variance)), "\n")
cat("==================================================\n")
