)
# The fix is adding the names_sep argument to unnest()
processed_data <- test_data %>%
unnest(topics, names_sep = "_") %>% # This is the key change!
pivot_wider(
names_from = topics_name,         # Use the newly prefixed column name
values_from = topics_display_name # Use the newly prefixed column name
)
View(processed_data)
processed_data <- test_data %>%
# Use map to go into each nested dataframe and rename the 'id' column
mutate(topics = map(topics, ~ rename(.x, entity_id = id))) %>%
# Now unnest() will work without any issues
unnest(topics) %>%
# The rest of the code is the same
pivot_wider(
names_from = name,
values_from = display_name
)
