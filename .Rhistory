# --- Function to get recent works from an institution using openalexr ---
get_institution_works <- function(institution_id, count = 25) {
message(paste("Fetching recent works from institution ID:", institution_id))
# Use oa_fetch to get works, sorted by publication date
works_df <- oa_fetch(
entity = "works",
authorships.institutions.id = institution_id,
per_page = count,
sort = "publication_date:desc",
output = "tibble" # Ensure output is a tibble
)
# Check if any works were returned
if (is.null(works_df) || nrow(works_df) == 0) {
message("No works found for this institution.")
return(NULL)
}
# Select relevant columns for clarity
works_df <- works_df %>%
select(id, display_name, publication_date, cited_by_count)
return(works_df)
}
# --- Function to get citing authors for a specific work using openalexr ---
get_citing_authors <- function(work_id, count = 50) {
message(paste("\nFetching citing works for OpenAlex Work ID:", work_id))
# Use oa_fetch to get works that cite the given work_id
citing_works <- oa_fetch(
entity = "works",
cites = work_id,
per_page = count,
output = "tibble"
)
# Check if any citing works were found
if (is.null(citing_works) || nrow(citing_works) == 0) {
message("No citing works found for this publication.")
return(NULL)
}
# The 'authorships' column is a nested list of dataframes. We need to unnest it.
# This process extracts author and institution details for each citing paper.
citing_authors <- citing_works %>%
select(id, display_name, authorships) %>%
unnest(authorships) %>%
# The institutions are also nested within authorships, so we unnest them again
unnest(institutions) %>%
select(
citing_work_id = id,
citing_work_title = display_name,
author_name = display_name.author, # Column name after unnesting author
author_orcid = orcid,
institution_name = display_name.institutions, # Column name after unnesting institutions
institution_country = country_code,
institution_type = type
)
return(citing_authors)
}
