expected_result <- c(
"PMC1234567",
"PMC7654321",
"PMC1112223",
NA_character_,
NA_character_
)
if (!identical(test_result, expected_result)) {
stop(
"The PMCID extraction test failed.\n",
"Obtained: ",
paste(test_result, collapse = ", ")
)
}
message("PMCID extractor test passed.")
