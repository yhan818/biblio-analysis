cqn_wide |>
dplyr::summarise(
dplyr::across(
c(countries_distinct_count, institutions_distinct_count,
authorships_countries, funder_display_names, award_ids,
author_names_clean, institution_names_clean),
~ round(mean(!is.na(.x)), 3)
)
) |> t()
