# 3. Merge them (The Reconciliation)
# all = TRUE performs a 'Full Join'
audit <- merge(ledger_25, ledger_26, by = "id", all = TRUE)
# 4. Handle NAs (The Base R way - no 'replace_na' needed)
audit[is.na(qty_25), qty_25 := 0]
audit[is.na(qty_26), qty_26 := 0]
# 5. Calculate the Growth
audit[, delta := qty_26 - qty_25]
# 6. View the Top Performers (>10 citations)
top_performers <- audit[qty_26 >= 10][order(-qty_26)]
common_stable <- audit[delta == 0 & qty_25 > 0]
# Find "Compliance Violations" (where citations were lost)
violations <- audit[qty_25 > 0 & qty_26 < qty_25]
if (nrow(violations) == 0) {
message("AUDIT PASSED: All 2025 frequencies are preserved or grown in 2026.")
} else {
message("AUDIT ALERT: ", nrow(violations), " articles lost citation frequency.")
}
# Total Growth (New citations for existing or new IDs)
growth_rows <- sum(audit[delta > 0, delta])
# Total Leakage (Citations that existed in 2025 but vanished in 2026)
leakage_rows <- sum(audit[delta < 0, abs(delta)])
cat(
"Starting Inventory (2025): ", sum(audit$qty_25), "\n",
"Net Growth (Additions):    ", growth_rows, "\n",
"Leakage (Asset Write-offs): ", leakage_rows, "\n",
"Final Inventory (2026):    ", sum(audit$qty_26), "\n"
)
# 6. View the Top Performers (>10 citations)
