library(fuzzyjoin)
# 2. Read the file (assuming no headers)
# We use col_names = FALSE because the Excel file has no header row
df <- read_excel("New list for faculty collaborations.xlsx", col_names = FALSE)
# 3. Split, Rename, and Trim explicitly
# We split the first column (...1) into 'Last_Name' and 'First_Name' (no spaces to avoid errors)
faculty_prep <- df %>%
separate(col = `...1`, into = c("Last_Name", "First_Name"), sep = ",", extra = "merge") %>%
mutate(
# Standardize columns: trim whitespace and convert to uppercase
Last_Name   = str_to_upper(trimws(Last_Name)),
First_Name  = str_to_upper(trimws(First_Name)),
Institution = trimws(`...4`), # '...4' is the Institution column
# Create the key for fuzzy matching
match_key   = paste(Last_Name, First_Name, sep = ", ")
)
# 4. Prepare authors_df (Standardize to UPPERCASE and Trim)
authors_prep <- authors_df %>%
mutate(
# Standardize your existing author names to match the faculty list format
author_match_key = str_to_upper(trimws(name))
)
# 5. Perform Fuzzy Matching
matched_authors <- stringdist_inner_join(
faculty_prep,
authors_prep,
by = c("match_key" = "author_match_key"),
max_dist = 2,    # Allows for middle initials or minor typos
method = "lv"    # Levenshtein distance
) %>%
# IMPORTANT: fuzzyjoin often appends .x to the left-side columns
# We select the columns by their new names or original names
select(
`Last Name` = Last_Name,
`First Name` = First_Name,
Institution
) %>%
distinct()
# 6. Output the matches
print("--- Fuzzy Matched Author Names Found ---")
print(matched_authors)
# 1. Load the necessary libraries
library(readxl)
library(dplyr)
library(tidyr)
library(stringr)
library(fuzzyjoin) # Ensure this is installed: install.packages("fuzzyjoin")
# 2. Read the faculty list
df <- read_excel("New list for faculty collaborations.xlsx", col_names = FALSE)
# 3. Prepare the Faculty List (Clean, Trim, and Uppercase)
faculty_prep <- df %>%
# Split the name column into Last_Name and First_Name
separate(col = `...1`, into = c("Last_Name", "First_Name"), sep = ",", extra = "merge") %>%
mutate(
# Trim whitespace and convert to uppercase to ignore case
Last_Name  = str_to_upper(trimws(Last_Name)),
First_Name = str_to_upper(trimws(First_Name)),
# Create the key for fuzzy matching
match_key  = paste(Last_Name, First_Name, sep = ", ")
)
# 4. Prepare your authors_df
# We assume 'name' is the column containing "LAST, FIRST" in authors_df
authors_prep <- authors_df %>%
mutate(
author_match_key = str_to_upper(trimws(name))
)
# 5. Perform Fuzzy Matching (Ignoring Institution)
matched_results <- stringdist_inner_join(
faculty_prep,
authors_prep,
by = c("match_key" = "author_match_key"),
max_dist = 2,    # Allows for middle initials or minor variations
method = "lv"    # Levenshtein distance calculation
)
# 6. Output the Matched Names
# Since fuzzyjoin may add suffixes (.x or .y), we select the specific columns we created
final_matches <- matched_results %>%
select(
`Last Name` = Last_Name,
`First Name` = First_Name
) %>%
distinct()
print("--- Matched Author Names ---")
print(final_matches)
# Check format of Faculty List
print("--- Faculty List Names (Top 5) ---")
print(head(faculty_prep$match_key))
# Check format of your Author List
# Replace 'name' with your actual column name
print("--- Your authors_df Names (Top 5) ---")
print(head(str_to_upper(trimws(authors_df$name))))
# 1. Clean Faculty List (Remove punctuation)
faculty_prep <- df %>%
separate(col = `...1`, into = c("Last_Name", "First_Name"), sep = ",", extra = "merge") %>%
mutate(
# Remove periods and commas for a cleaner match
clean_last  = str_replace_all(str_to_upper(trimws(Last_Name)), "[[:punct:]]", ""),
clean_first = str_replace_all(str_to_upper(trimws(First_Name)), "[[:punct:]]", ""),
match_key   = paste(clean_last, clean_first) # No comma in key
)
# 2. Clean your authors_df
authors_prep <- authors_df %>%
mutate(
# Replace 'name' with your actual column name
# Remove punctuation and standardize to uppercase
author_match_key = str_replace_all(str_to_upper(trimws(name)), "[[:punct:]]", "")
)
# 3. Perform Ultra-Fuzzy Match
# We increase max_dist to 10 to catch "Last, First Middle" vs "Last, First"
matched_results <- stringdist_inner_join(
faculty_prep,
authors_prep,
by = c("match_key" = "author_match_key"),
max_dist = 10,
method = "lv"
)
# 4. View Matches
final_matches <- matched_results %>%
select(
Faculty_Name = match_key,
Author_DF_Name = author_match_key
) %>%
distinct()
print(final_matches)
