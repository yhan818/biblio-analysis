domain_results_2024$data %>% mutate(Citing_Year = 2024)
) %>%
# 1. [NEW LINE ADDED HERE] Filter out rows where year_category is "Other"
filter(year_category != "Other") %>%
# 2. [NEW STEP] Sort by domain_L1 (primary sort) then by Citing_Year (secondary sort)
arrange(domain_L1, Citing_Year)
# View the combined data for comparison
print(all_domain_patterns)
### Visualization
ggplot(all_domain_patterns, aes(x = year_category, y = domain_L1, fill = percent_numeric)) +
# Use facet_grid to separate the plots by Citing_Year
geom_tile(color = "white") +
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
color = "black",
size = 3) +
facet_grid(. ~ Citing_Year) + # Facet by year across the columns
scale_fill_gradient(low = "#e5f5e0", high = "#31a354") +
labs(
title = "Citation Age Distribution by Domain (2022-2024)",
subtitle = "Darker colors indicate a higher proportion of citations from that period.",
x = "Citation Period",
y = "Domain",
fill = "Proportion"
) +
theme_minimal() +
theme(panel.grid = element_blank())
ggplot(all_domain_patterns, aes(x = domain_L1, y = percent_numeric, fill = year_category)) +
geom_col(position = "stack") + # Use the percentage data (y=percent_numeric)
facet_wrap(~ Citing_Year, ncol = 1) + # Stack vertically for a clear comparison
scale_y_continuous(labels = scales::percent) +
labs(
title = "Citation Age Pattern Trend (2022-2024)",
subtitle = "Composition of citation age for each domain, faceted by year.",
x = "Domain",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) # Rotate X-axis labels for readability
# 🛑 CHANGE THIS LINE: Set the domain you want to visualize
# (e.g., "Physical Sciences", "Health Sciences", "Life Sciences", "Social Sciences")
domain_to_plot <- "Physical Sciences"
single_domain_data <- all_domain_patterns %>%
filter(domain_L1 == domain_to_plot)
# Create the Grouped Column Chart
ggplot(single_domain_data,
aes(x = factor(Citing_Year), # Treat year as discrete
y = percent_numeric,
fill = year_category)) +
# Grouped columns showing the age distribution per year
geom_col(position = "dodge", color = "black", alpha = 0.8) +
# Add text labels for the percentage values
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 3) +
# Format the Y-axis and set custom colors
scale_y_continuous(labels = scales::percent, limits = c(0, max(single_domain_data$percent_numeric) * 1.1)) +
scale_fill_brewer(palette = "Set1") + # Using a reliable RColorBrewer palette (Set1 has 9 colors)
labs(
title = paste("Citation Age Trend for:", domain_to_plot, "(2022-2024)"),
subtitle = "Change in the proportion of citations from different age categories.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(legend.position = "bottom")
# Option 2: Plotting ALL domains at once using the combined 'all_domain_patterns' data frame
ggplot(all_domain_patterns,
aes(x = factor(Citing_Year),
y = percent_numeric,
fill = year_category)) +
geom_col(position = "dodge", color = "black", alpha = 0.8) +
# 🛑 THE KEY CHANGE: Use facet_wrap to create a panel for each domain
facet_wrap(~ domain_L1, scales = "free_y") +
scale_y_continuous(labels = scales::percent) +
scale_fill_brewer(palette = "Set1") +
labs(
title = "Citation Age Trend by Domain (2022-2024)",
subtitle = "Separate panels show the change for each domain over time.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(legend.position = "bottom")
# --- 1. Combine and Sort the Field Data ---
# Use the $data element from the list output and add the Citing_Year
all_field_patterns <- bind_rows(
field_results_2022$data %>% mutate(Citing_Year = 2022),
field_results_2023$data %>% mutate(Citing_Year = 2023),
field_results_2024$data %>% mutate(Citing_Year = 2024)
) %>%
# 1. Filter out rows where year_category is "Other"
filter(year_category != "Other") %>%
# 2. Sort first by the field, then by the year
arrange(field_L1, Citing_Year)
# --- 2. Filter out NA/Missing Fields (Recommended) ---
# Based on earlier requests, this ensures the '<NA>' field category is removed
all_field_patterns <- all_field_patterns %>%
filter(!is.na(field_L1))
# --- 3. Visualize Trend for ALL Fields using Faceting ---
# --- Visualization Code with Smaller Text Size ---
ggplot(all_field_patterns,
aes(x = factor(Citing_Year),
y = percent_numeric,
fill = year_category)) +
geom_col(position = "dodge", color = "black", alpha = 0.8) +
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 1.2) +
# 🛑 UPDATED: Added labeller argument to wrap the field names
facet_wrap(~ field_L1,
scales = "free_y",
labeller = label_wrap_gen(width = 20)) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Citation Age Trend by Field (2022-2024)",
subtitle = "Change in citation age composition for all specific fields.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(
legend.position = "bottom",
axis.text.x = element_text(angle = 45, hjust = 1)
)
View(final_p)
# --- 3. Visualize Trend for ALL Fields using Faceting ---
# --- Visualization Code with Smaller Text Size ---
ggplot(all_field_patterns,
aes(x = factor(Citing_Year),
y = percent_numeric,
fill = year_category)) +
geom_col(position = "dodge", color = "black", alpha = 0.8) +
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 1.2) +
# 🛑 UPDATED: Added labeler argument to wrap the field names
facet_wrap(~ field_L1,
scales = "free_y",
labeller = label_wrap_gen(width = 20)) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Citation Age Trend by Field (2022-2024)",
subtitle = "Change in citation age composition for all specific fields.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(
legend.position = "bottom",
axis.text.x = element_text(angle = 45, hjust = 1)
)
# Get the unique field names and assign a page number to each.
# We arrange by field_L1 first to ensure the fields are grouped consistently.
fields_to_page <- all_field_patterns %>%
ungroup() %>%
distinct(field_L1) %>%
arrange(field_L1) %>%
mutate(page_group = ceiling(row_number() / 4)) # Assigns pages of 4
# Join the page group back to the main data
all_field_patterns_paged <- all_field_patterns %>%
left_join(fields_to_page, by = "field_L1") %>%
# Filter out any NA/missing fields one last time for safety
filter(!is.na(field_L1))
# --- 2. Iterate and Generate a Plot for Each Page Group ---
# This loop will print out one plot after another in your R console or RStudio viewer.
num_pages <- max(all_field_patterns_paged$page_group)
for (p in 1:num_pages) {
# Filter the data for the current page
data_current_page <- all_field_patterns_paged %>%
filter(page_group == p)
# Generate the plot for the current page
plot_page <- ggplot(data_current_page,
aes(x = factor(Citing_Year),
y = percent_numeric,
fill = year_category)) +
geom_col(position = "dodge", color = "black", alpha = 0.8) +
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 1.5) +
# Facet only on the 4 fields in the current data chunk
facet_wrap(~ field_L1,
scales = "free_y",
labeller = label_wrap_gen(width = 20)) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
scale_fill_brewer(palette = "Set3") +
labs(
title = paste("Citation Age Trend by Field (Page", p, "of", num_pages, ")"),
subtitle = "Change in citation age composition for specific fields.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(
legend.position = "bottom",
axis.text.x = element_text(angle = 45, hjust = 1)
)
# Print the plot
print(plot_page)
# Optional: You can uncomment the line below to save each plot as a file
# ggsave(plot = plot_page, filename = paste0("Field_Trend_Page_", p, ".png"), width = 10, height = 8)
}
View(domain_results_2022)
# --- 1. Combine and Sort the Field Data ---
# --- 2. Combine, Sort, and SIMPLIFY the Data ---
all_field_patterns <- bind_rows(
field_results_2022$data %>% mutate(Citing_Year = 2022),
field_results_2023$data %>% mutate(Citing_Year = 2023),
field_results_2024$data %>% mutate(Citing_Year = 2024)
) %>%
# Filter out NA/missing fields
filter(!is.na(field_L1)) %>%
# --- NEW: Create Simplified Age Group ---
mutate(
age_group_simplified = case_when(
# Cat_1 (e.g., 2019-2024) = "Year 0-5"
year_category == paste0(Citing_Year - 5, "-", Citing_Year) ~ "Year 0-5",
# Cat_2 (e.g., 2014-2018) = "Year 6-10"
grepl("^-", year_category) == FALSE & grepl("-", year_category) == TRUE ~ "Year 6-10",
# Cat_3 (e.g., -2013) = "Year 11+"
grepl("^-", year_category) == TRUE ~ "Year 11+",
# Handle 'Other' (though should be rare after NA filter)
TRUE ~ "Other"
),
# Ensure simplified groups are factored in a clear order
age_group_simplified = factor(age_group_simplified,
levels = c("Year 0-5", "Year 6-10", "Year 11+", "Other"))
) %>%
# Sort first by the field, then by the year
arrange(field_L1, Citing_Year)
# --- 3. Visualize Trend for ALL Fields using Faceting ---
# --- Visualization 2. Create Page Groups (4 fields per page) ---
# --- 3. Create Page Groups (4 fields per page) ---
fields_to_page <- all_field_patterns %>%
ungroup() %>%
distinct(field_L1) %>%
arrange(field_L1) %>%
mutate(page_group = ceiling(row_number() / 4))
all_field_patterns_paged <- all_field_patterns %>%
left_join(fields_to_page, by = "field_L1") %>%
filter(!is.na(field_L1))
# --- 4. Iterate and Generate a Plot for Each Page Group ---
num_pages <- max(all_field_patterns_paged$page_group)
for (p in 1:num_pages) {
data_current_page <- all_field_patterns_paged %>%
filter(page_group == p)
plot_page <- ggplot(data_current_page,
aes(x = factor(Citing_Year),
y = percent_numeric,
# 🛑 KEY CHANGE: Use the new simplified column for fill
fill = age_group_simplified)) +
geom_col(position = "dodge", color = "black", alpha = 0.8) +
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 1.5) +
facet_wrap(~ field_L1,
scales = "free_y",
labeller = label_wrap_gen(width = 20)) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
# 🛑 KEY CHANGE: Use a 3-color scale (Set1 or manual)
scale_fill_manual(values = c("Year 0-5" = "#0072B2",   # Blue (Recent)
"Year 6-10" = "#F0E442", # Yellow/Gold (Mid-Age)
"Year 11+" = "#D55E00",  # Red/Orange (Oldest)
"Other" = "gray80")) +  # Gray for 'Other'
labs(
title = paste("Citation Age Trend by Field (Page", p, "of", num_pages, ")"),
subtitle = "Citation age simplified into 3 groups.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(
legend.position = "bottom",
axis.text.x = element_text(angle = 45, hjust = 1)
)
print(plot_page)
# Optional: You can uncomment the line below to save each plot as a file
# ggsave(plot = plot_page, filename = paste0("Field_Trend_Page_", p, ".png"), width = 10, height = 8)
}
# --- 2. Combine, Sort, and SIMPLIFY the Data ---
all_field_patterns <- bind_rows(
field_results_2022$data %>% mutate(Citing_Year = 2022),
field_results_2023$data %>% mutate(Citing_Year = 2023),
field_results_2024$data %>% mutate(Citing_Year = 2024)
) %>%
# Filter out NA/missing fields (done previously)
filter(!is.na(field_L1)) %>%
# Create Simplified Age Group
mutate(
age_group_simplified = case_when(
# Cat_1 (e.g., 2019-2024) = "Year 0-5"
year_category == paste0(Citing_Year - 5, "-", Citing_Year) ~ "Year 0-5",
# Cat_2 (e.g., 2014-2018) = "Year 6-10"
grepl("^-", year_category) == FALSE & grepl("-", year_category) == TRUE ~ "Year 6-10",
# Cat_3 (e.g., -2013) = "Year 11+"
grepl("^-", year_category) == TRUE ~ "Year 11+",
# Default should ideally not happen after NA filtering, but is still 'Other'
TRUE ~ "Other"
),
# Ensure simplified groups are factored in a clear order
age_group_simplified = factor(age_group_simplified,
levels = c("Year 0-5", "Year 6-10", "Year 11+", "Other"))
) %>%
# 🛑 NEW STEP: Remove the "Other" category from the visualization data set
filter(age_group_simplified != "Other") %>%
# Sort first by the field, then by the year
arrange(field_L1, Citing_Year)
# --- 3. Create Page Groups (4 fields per page) ---
fields_to_page <- all_field_patterns %>%
ungroup() %>%
distinct(field_L1) %>%
arrange(field_L1) %>%
mutate(page_group = ceiling(row_number() / 4))
all_field_patterns_paged <- all_field_patterns %>%
left_join(fields_to_page, by = "field_L1") %>%
filter(!is.na(field_L1))
# --- 4. Iterate and Generate a Plot for Each Page Group ---
num_pages <- max(all_field_patterns_paged$page_group)
for (p in 1:num_pages) {
data_current_page <- all_field_patterns_paged %>%
filter(page_group == p)
plot_page <- ggplot(data_current_page,
aes(x = factor(Citing_Year),
y = percent_numeric,
fill = age_group_simplified)) +
geom_col(position = "dodge", color = "black", alpha = 0.8) +
geom_text(aes(label = scales::percent(percent_numeric, accuracy = 1)),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 1.5) +
facet_wrap(~ field_L1,
scales = "free_y",
labeller = label_wrap_gen(width = 20)) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1)) +
# 🛑 MODIFIED: Removed "Other" from the scale_fill_manual values,
# but kept the three primary colors.
scale_fill_manual(values = c("Year 0-5" = "#0072B2",
"Year 6-10" = "#F0E442",
"Year 11+" = "#D55E00")) +
labs(
title = paste("Citation Age Trend by Field (Page", p, "of", num_pages, ")"),
subtitle = "Citation age simplified into 3 groups.",
x = "Citing Year",
y = "Percentage of Citations",
fill = "Citation Period"
) +
theme_minimal() +
theme(
legend.position = "bottom",
axis.text.x = element_text(angle = 45, hjust = 1)
)
print(plot_page)
}
for (p in 1:num_pages) {
