strsplit(ua_author_names, "; "),
function(names) {
if (all(is.na(names))) return(NA_character_)
cleaned <- sapply(names, clean_author_name)
# Title case for display
cleaned <- gsub("(^|\\s)(\\w)", "\\1\\U\\2", cleaned, perl = TRUE)
paste(unique(cleaned), collapse = "; ")
}
)),
by = "work_id"
)
