faculty_prep <- df_split %>%
mutate(
# Explicitly trim the Last Name and First Name to avoid matching errors
`Last Name` = trimws(`Last Name`),
`First Name` = trimws(`First Name`),
match_key = str_to_upper(paste(`Last Name`, `First Name`, sep = ", "))
)
# 3. Prepare your authors_df
authors_prep <- authors_df %>%
mutate(
# Standardize your existing author names: Trim and Upper Case
author_match_key = str_to_upper(trimws(name))
)
# 4. Perform Fuzzy Match using fuzzyjoin
matched_authors <- stringdist_inner_join(
faculty_prep,
authors_prep,
by = c("match_key" = "author_match_key"),
max_dist = 2,    # Allows for minor differences like middle initials
method = "lv"    # Levenshtein distance: counts the number of edits between names
) %>%
# Keep only the original columns from your faculty list
select(`Last Name`, `First Name`, Institution) %>%
distinct()
# 5. Output the result
print("--- Fuzzy Matched Author Names Found ---")
print(matched_authors)
