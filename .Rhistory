n_auth <- purrr::map_int(works_raw_full, ~ length(.x$authorships %||% list()))
table(cut(n_auth, c(-1, 0, 1, 10, 50, 99, Inf)))
sum(n_auth >= 100)
# 4. Type mix
table(purrr::map_chr(works_raw_full, ~ .x$type %||% NA_character_), useNA = "ifany")
# 5. Local tibble conversion, no API cost -- does it survive the xpac records?
works_tbl <- openalexR::works2df(works_raw_full)
dim(works_tbl); names(works_tbl)
library(dplyr); library(purrr); library(tibble); library(stringr); library(tidyr)
`%||%` <- function(x, y) if (is.null(x)) y else x
strip_oa <- function(x) sub("^https?://openalex\\.org/", "", x)
# Scalar getters, NA-safe against missing/empty nested paths
gs <- function(w, ..., .type = NA_character_) {
v <- purrr::pluck(w, ...)
if (is.null(v) || length(v) == 0) return(.type)
v <- v[[1]]
if (is.null(v)) .type else v
}
g_chr <- function(w, ...) as.character(gs(w, ..., .type = NA_character_))
g_int <- function(w, ...) suppressWarnings(as.integer(gs(w, ..., .type = NA_integer_)))
g_dbl <- function(w, ...) suppressWarnings(as.numeric(gs(w, ..., .type = NA_real_)))
g_lgl <- function(w, ...) as.logical(gs(w, ..., .type = NA))
# Collapse a character vector to one delimited cell
cc <- function(x, sep = "; ", dedupe = FALSE) {
x <- unlist(x, use.names = FALSE)
x <- x[!is.na(x) & nzchar(x)]
if (dedupe) x <- unique(x)
if (!length(x)) NA_character_ else paste(x, collapse = sep)
}
rebuild_abstract <- function(aii) {
if (is.null(aii) || !length(aii)) return(NA_character_)
pos <- unlist(aii, use.names = FALSE)
wrd <- rep(names(aii), lengths(aii))
paste(wrd[order(pos)], collapse = " ")
}
extract_people <- function(w) {
a <- w$authorships %||% list()
# --- USER-FRIENDLY 1: author names only. No IDs, no affiliations. Order preserved.
author_names <- map_chr(a, ~ g_chr(.x, "author", "display_name"))
# --- USER-FRIENDLY 2: institution display names. Names only, deduped across work.
inst_by_author <- map(a, function(au) {
map_chr(au$institutions %||% list(), ~ g_chr(.x, "display_name"))
})
# --- ADDED: authorships.countries, per author, author order preserved.
# Prefer authorship-level `countries`; fall back to institution country_code.
ctry_by_author <- map(a, function(au) {
ctry <- unlist(au$countries %||% list(), use.names = FALSE)
if (!length(ctry)) ctry <- map_chr(au$institutions %||% list(), ~ g_chr(.x, "country_code"))
ctry <- as.character(ctry)
ctry[!is.na(ctry) & nzchar(ctry)]
})
has_native_ctry <- length(unlist(map(a, ~ .x$countries %||% list()), use.names = FALSE)) > 0
ctry_src <- if (has_native_ctry) "authorship.countries" else
if (length(unlist(ctry_by_author))) "institution.country_code" else NA_character_
# "|" separates authors; "," separates multiple countries within one author
authorships_countries <- if (!length(a)) NA_character_ else
paste(map_chr(ctry_by_author, ~ if (!length(.x)) "" else paste(.x, collapse = ",")), collapse = " | ")
corr <- which(map_lgl(a, ~ isTRUE(g_lgl(.x, "is_corresponding"))))
tibble(
authors_count             = length(a),
author_names_clean        = cc(author_names),
first_author_name         = if (length(author_names)) author_names[1] else NA_character_,
last_author_name          = if (length(author_names)) author_names[length(author_names)] else NA_character_,
institution_names_clean   = cc(unlist(inst_by_author), dedupe = TRUE),
authorships_countries     = authorships_countries,
authorships_countries_src = ctry_src,
distinct_countries_list   = cc(unlist(ctry_by_author), sep = "; ", dedupe = TRUE),
# --- ADDED: OpenAlex's own computed counts (authoritative)
countries_distinct_count     = g_int(w, "countries_distinct_count"),
institutions_distinct_count  = g_int(w, "institutions_distinct_count"),
# locally recomputed, for cross-check against truncation
countries_distinct_computed    = length(unique(unlist(ctry_by_author, use.names = FALSE))),
institutions_distinct_computed = length(unique(na.omit(unlist(inst_by_author, use.names = FALSE)))),
corresponding_author_names      = cc(author_names[corr]),
corresponding_institution_names = cc(unlist(inst_by_author[corr]), dedupe = TRUE),
authorships_truncated_flag      = length(a) >= 100
)
}
####  call cqn/04_extract
source("cqn/04_extract.R")
people <- purrr::map_dfr(works_raw_full, extract_people)
people$requested_work_id <- vapply(
works_raw_full,
function(w) strip_oa(w$id),
character(1)
)
people <- dplyr::relocate(people, requested_work_id)
dim(people)   # expect 1194 rows
## 1. Do OpenAlex's counts agree with mine? Disagreements are informative,
##    not necessarily wrong -- they flag ROR-unmatched affiliations.
people |>
dplyr::mutate(
ctry_gap = countries_distinct_count    - countries_distinct_computed,
inst_gap = institutions_distinct_count - institutions_distinct_computed
) |>
dplyr::count(ctry_gap, inst_gap, sort = TRUE) |>
print(n = 20)
## 2. Does the "|" count line up with authors_count? (should be n-1 pipes)
dplyr::filter(authors_count > 0) |>
View(people)
View(people)
gap_ids <- people |>
dplyr::mutate(inst_gap = institutions_distinct_count - institutions_distinct_computed) |>
dplyr::filter(inst_gap > 0) |>
dplyr::select(requested_work_id, authors_count, inst_gap,
institutions_distinct_count, institutions_distinct_computed,
authorships_truncated_flag)
print(gap_ids, n = 20)
w <- works_raw_full[[gap_ids$requested_work_id[which.max(gap_ids$inst_gap)]]]
lapply(w$authorships, function(au) {
lapply(au$institutions, function(i) c(id = i$id, name = i$display_name))
})
