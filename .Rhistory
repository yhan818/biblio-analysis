# 2. Assign a "Sequence Number" to every single citation event
# This turns "ID" into "ID + Instance Number" (e.g., the 5th time this ID appears)
ver2025[, instance_id := rowid(id)]
ver2026[, instance_id := rowid(id)]
# 3. Perform a Full Outer Join on the Composite Key (ID + Instance)
# This matches the 1st citation of Article A in 2025 to the 1st citation of Article A in 2026.
row_audit <- merge(
ver2025[, .(id, instance_id)],
ver2026[, .(id, instance_id)],
by = c("id", "instance_id"),
all = TRUE,
suffixes = c("_25", "_26"),
indicator = TRUE # This tells us if the row is in both, or just one
)
# 4. Verify the Equation: Ver2026 = (Matched Ver2025) + Growth
matched_rows <- nrow(row_audit[id != "" & !is.na(instance_id) & !is.na(id)]) # Found in both
lost_rows    <- nrow(row_audit[is.na(id) | is.na(instance_id)]) # Wait, let's use the helper:
